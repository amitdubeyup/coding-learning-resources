# Copy to `.env` and fill in real values. NEVER commit the real .env.
# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL (optional) ---
# Leave DJANGO_DB_HOST unset to use local SQLite instead.
# DJANGO_DB_NAME=your_db
# DJANGO_DB_USER=your_user
# DJANGO_DB_PASSWORD=your_password
# DJANGO_DB_HOST=your-host.example.com
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=require
